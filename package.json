{
  "name": "unfocus",
  "private": true,
  "version": "0.6.0-beta.2",
  "description": "Local-first break and reflection app: look away when it is time, and see how your day went",
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": "1.3.5"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "clippy:complexity": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings -D clippy::cognitive-complexity -D clippy::too-many-lines",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
    "test": "bun test",
    "tauri": "tauri",
    "dependencies:check": "bun run scripts/audit-bun.js",
    "dependencies:audit-rust": "bun run scripts/audit-rust.js",
    "debian:finalize": "bun run scripts/debian-package.js finalize",
    "debian:metadata": "bun run scripts/generate-debian-metadata.js",
    "debian:qualify-published": "bun run scripts/debian-package.js qualify-published",
    "debian:verify": "bun run scripts/debian-package.js verify",
    "notices:check": "bun run scripts/generate-third-party-notices.js --check",
    "notices:generate": "bun run scripts/generate-third-party-notices.js",
    "release:assemble": "bun run scripts/assemble-release-artifacts.js",
    "release:finalize": "bun run scripts/finalize-release-artifacts.js",
    "release:inspect-linux": "bun run scripts/inspect-linux-packages.js",
    "release:notes": "bun run scripts/extract-release-notes.js",
    "release:sign-linux-update": "bun run scripts/sign-linux-update.js",
    "release:update-envelope": "bun run scripts/linux-update-envelope.js",
    "release:verify-final": "bun run scripts/verify-final-release.js",
    "release:verify-update-signature": "cargo run --quiet --locked --manifest-path src-tauri/Cargo.toml --example verify-update-signature --",
    "release:verify-macos-bundle": "bun run scripts/verify-macos-bundle-signature.js",
    "sbom:generate": "bun run scripts/generate-sbom.js",
    "toolchains:check": "bun run scripts/check-toolchain-versions.js",
    "tray:generate": "bun run scripts/gen-tray-icons.js",
    "version:check": "bun run scripts/version.js check",
    "version:set": "bun run scripts/version.js set"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@7",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6",
    "vite": "^8.2.2"
  }
}
