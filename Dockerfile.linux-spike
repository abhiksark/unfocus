FROM rust:1.95-bookworm

ARG HOST_UID=1000
ARG HOST_GID=1000

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        file \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        libssl-dev \
        libwebkit2gtk-4.1-dev \
        libxdo-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${HOST_GID}" spike \
    && useradd --create-home --uid "${HOST_UID}" --gid "${HOST_GID}" spike

RUN rustup component add clippy rustfmt

USER spike
WORKDIR /workspace

CMD ["cargo", "run", "--features", "tauri/custom-protocol", "--manifest-path", "src-tauri/Cargo.toml"]
