{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unfocus",
  "version": "0.6.0-beta.2",
  "identifier": "com.unfocus.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "bun run debian:metadata",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Unfocus",
        "width": 920,
        "height": 700,
        "minWidth": 760,
        "minHeight": 580,
        "center": true,
        "backgroundColor": [11, 16, 13, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libc6"],
        "files": {
          "/usr/share/doc/unfocus/changelog.Debian.gz": "target/release/debian-metadata/changelog.Debian.gz",
          "/usr/share/doc/unfocus/changelog.gz": "target/release/debian-metadata/changelog.gz",
          "/usr/share/doc/unfocus/copyright": "../LICENSE"
        },
        "section": "utils"
      }
    },
    "windows": {
      "wix": {
        "version": "0.6.0"
      }
    }
  }
}
